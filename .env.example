# Local development defaults. On Hugging Face Spaces, add these as Variables (not source code).
EIM_BACKEND=local
EIM_MODEL=Qwen/Qwen3-4B-Instruct-2507-FP8
EIM_CHAT_MODEL=Qwen/Qwen3-4B-Instruct-2507-FP8
EIM_GPU_SIZE=large
EIM_GPU_SECONDS=120
EIM_PROFILE=balanced
EIM_MAX_NEW_TOKENS=1536
EIM_INPUT_TOKENS=4096
EIM_CONTEXT_TOKENS=4096
EIM_RESULT_CACHE=0
EIM_WEB_TIMEOUT=5
# Optional private persistence: add HF_TOKEN as a Secret and set EIM_MEMORY_REPO to a private Dataset.
# EIM_MEMORY_REPO=your-account/your-private-dataset
# Optional prompt customization (max 5000 characters). See DEFAULT_REPAIR_RULES in app.py.
# EIM_REPAIR_RULES=...
